<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Hotel Room Reservation System</display-name>
    <description>OOP Java Project - Hotel Management System API</description>

    <!-- ============================================================
         Global CORS Filter
         ============================================================ -->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>shared.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============================================================
         Background Tasks Listener
         ============================================================ -->
    <listener>
        <listener-class>shared.AutoCheckOutListener</listener-class>
    </listener>

    <!-- ============================================================
         Servlet Declarations
         ============================================================ -->

    <!-- Module 1: Room Management -->
    <servlet>
        <servlet-name>RoomServlet</servlet-name>
        <servlet-class>servlets.RoomServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoomServlet</servlet-name>
        <url-pattern>/api/rooms</url-pattern>
    </servlet-mapping>

    <!-- Module 1b: Room Image Upload (file) -->
    <servlet>
        <servlet-name>RoomImageServlet</servlet-name>
        <servlet-class>servlets.RoomImageServlet</servlet-class>
        <multipart-config>
            <!-- 1 MB threshold before writing to temp disk -->
            <file-size-threshold>1048576</file-size-threshold>
            <!-- 10 MB max per file -->
            <max-file-size>10485760</max-file-size>
            <!-- 50 MB max total request -->
            <max-request-size>52428800</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoomImageServlet</servlet-name>
        <url-pattern>/api/rooms/image</url-pattern>
    </servlet-mapping>

    <!-- Module 1c: Room Image by URL (JSON) -->
    <servlet>
        <servlet-name>RoomImageUrlServlet</servlet-name>
        <servlet-class>servlets.RoomImageUrlServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoomImageUrlServlet</servlet-name>
        <url-pattern>/api/rooms/imageurl</url-pattern>
    </servlet-mapping>

    <!-- Module 2: Customer Management -->
    <servlet>
        <servlet-name>CustomerServlet</servlet-name>
        <servlet-class>servlets.CustomerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerServlet</servlet-name>
        <url-pattern>/api/customers</url-pattern>
    </servlet-mapping>

    <!-- Module 3: Reservation System -->
    <servlet>
        <servlet-name>ReservationServlet</servlet-name>
        <servlet-class>servlets.ReservationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReservationServlet</servlet-name>
        <url-pattern>/api/reservations</url-pattern>
    </servlet-mapping>

    <!-- Module 4: Payment Handling -->
    <servlet>
        <servlet-name>PaymentServlet</servlet-name>
        <servlet-class>servlets.PaymentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentServlet</servlet-name>
        <url-pattern>/api/payments</url-pattern>
    </servlet-mapping>

    <!-- Module 5: Staff / Admin -->
    <servlet>
        <servlet-name>StaffServlet</servlet-name>
        <servlet-class>servlets.StaffServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffServlet</servlet-name>
        <url-pattern>/api/staff</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StaffServlet</servlet-name>
        <url-pattern>/api/staff/login</url-pattern>
    </servlet-mapping>

    <!-- Module 6: Reports & Reviews -->
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>servlets.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/api/reports</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/api/reports/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/api/reviews</url-pattern>
    </servlet-mapping>

    <!-- ============================================================
         Welcome File
         ============================================================ -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- ============================================================
         Session Config
         ============================================================ -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
